#!/bin/bash

# Toggle focus between floating and tiled windows in Hyprland

if [[ $(hyprctl activewindow | grep -E "^	floating:" | tail -c 2 | head -c 1) == 1 ]]
then
  hyprctl dispatch "hl.dsp.window.cycle_next({ next = false, tiled = true })"
else
  hyprctl dispatch "hl.dsp.window.cycle_next({ next = false, floating = true })"
  hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = \"top\" })"
fi
